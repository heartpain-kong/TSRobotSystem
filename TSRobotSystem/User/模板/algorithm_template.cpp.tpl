#include "alg_xxx.h"

/* ============================================================================
 * 纯函数
 * ========================================================================== */

fp32 Alg_Xxx_Calc(fp32 __input)
{
    /* 防除零/防定义域(asin/acos 要 clamp 到 [-1,1])—— 这里别省 ✗ */
    return __input;
}

/* ============================================================================
 * 类
 * ========================================================================== */

void Class_Xxx::Init(fp32 __kp)
{
    kp = __kp;
    output = 0.0f;
}

fp32 Class_Xxx::Cout(fp32 __target, fp32 __now)
{
    /* 输入限幅 / 防除零 / 防定义域 */
    output = kp * (__target - __now);
    return output;
}
